# Recruiter X — environment template
#
# TWO destinations — keep them straight (see GAPS.md L20 / ARCHITECTURE.md §24):
#
#   1. PUBLIC (VITE_*)  → Vercel → Project → Settings → Environments, and
#      .env.local for dev. Vite BAKES these into the public browser bundle at
#      build time. Never put a secret behind a VITE_ prefix.
#
#   2. SECRETS          → Supabase Edge Function secrets:
#         supabase secrets set NAME=value [NAME2=value2 ...]
#      Read server-side via supabase/functions/_shared/env.ts. The healthCheck
#      function live-verifies each one returns results (see /SystemHealth).
#
# For local dev, .env.local may hold both (it is gitignored); only VITE_* vars
# reach the browser.

# ════════════════════════════════════════════════════════════════════════════
# 1. PUBLIC — Vercel env vars (+ .env.local)
# ════════════════════════════════════════════════════════════════════════════

# ─── Supabase (required) ───────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New-format publishable key (sb_publishable_...) or legacy anon JWT (eyJ...)
VITE_SUPABASE_ANON_KEY=sb_publishable_...your-key

# ─── App branding (optional) ───────────────────────────────────────────────
VITE_APP_NAME=Recruiter X
VITE_APP_URL=https://recruiterx.app

# ─── LiveKit browser URL (optional — video calls) ──────────────────────────
# The wss URL is public; the API key/secret are NOT (see secrets below).
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── Stripe publishable key (commercialization phase) ──────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=

# ════════════════════════════════════════════════════════════════════════════
# 2. SECRETS — Supabase Edge Function secrets (NEVER prefix with VITE_)
#    supabase secrets set OPENAI_API_KEY=sk-... ANTHROPIC_API_KEY=sk-ant-...
#
#    The browser never sees these keys. VITE_LLM_PROVIDER only chooses whether
#    the SPA calls the llmProxy Edge Function (openai/anthropic) or a local
#    model server (lmstudio / ollama, no key required).
# ════════════════════════════════════════════════════════════════════════════

# ─── Supabase service role (also used by scripts/import-csv-data.js) ───────
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ─── LLM providers (llmProxy + aiRecruiter* functions) ─────────────────────
# PRIMARY: Anthropic (default model claude-opus-4-8 — set in app_settings too)
ANTHROPIC_API_KEY=
# OpenAI retained for Whisper transcription (transcribeRecording) and as a fallback
OPENAI_API_KEY=
# Optional local model host for dev
OLLAMA_BASE_URL=

# DeepSeek (OpenAI-compatible): https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Alibaba / DashScope (OpenAI-compatible): https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Generic OpenAI-compatible endpoint (local Qwen via vLLM/llama.cpp/LM Studio server,
# or any hosted compatible API). Set both to enable.
#
# This is also how Edge Functions reach the LM Studio fleet on your laptop.
# Run ./scripts/tunnel-lmstudio.sh — it starts a shared-secret gateway, points
# a Cloudflare Tunnel at *that* (never at LM Studio directly), and prints the
# exact `supabase secrets set` line. OPENAI_COMPATIBLE_API_KEY is then the
# gateway secret from .lmstudio-tunnel.local, not a provider credential.
#
# Address the fleet by prefixing a model id with `local/`:
#   local/llama3.2-3b   →  tunnel   (logged at $0)
#   qwen2.5-coder-14b   →  Alibaba DashScope — the prefix is what tells them apart
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# Optional default model id for the generic endpoint.
OPENAI_COMPATIBLE_DEFAULT_MODEL=

# ─── Local / hosted OpenAI-compatible models (browser-direct) ──────────────
# Set VITE_LLM_PROVIDER to one of:
#   - lmstudio        → LM Studio local server (default http://localhost:1234/v1)
#   - ollama          → Ollama local server (default http://localhost:11434)
#   - openai-compatible → any other /v1 endpoint (Qwen via vLLM/llama.cpp, hosted proxy)
#
# NOTE: localhost is browser-only. Supabase Edge Functions (resume parsing, AI
# recruiter, inbound classification, follow-up cron) cannot reach your laptop.
# For server-side use, either use DeepSeek / DashScope keys above, or publish
# the fleet with ./scripts/tunnel-lmstudio.sh and set OPENAI_COMPATIBLE_*.
#
# ⚠ Never put the tunnel secret in a VITE_* var — those are inlined into the
#   public browser bundle at build time, which publishes it. The browser does
#   not need it: keep VITE_LLM_PROVIDER=lmstudio and it calls localhost direct.
VITE_LLM_PROVIDER=
VITE_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Optional: pin one model for everything (an exact id from /v1/models).
VITE_LMSTUDIO_MODEL=
# Optional: pin per task bucket or per task label. Buckets are parsing,
# scoring, matching, analysis, classification, drafting, chat, default.
#   VITE_LMSTUDIO_MODEL_MAP={"parsing":"qwen2.5-14b","chat":"llama-3.2-3b"}
VITE_LMSTUDIO_MODEL_MAP=

# Generic OpenAI-compatible endpoint used when VITE_LLM_PROVIDER=openai-compatible.
# Useful for local Qwen (vLLM/llama.cpp) or a hosted proxy that does its own auth.
#
# Option B — a hosted endpoint that does its own auth. NOT the LM Studio tunnel:
# that one is authenticated with a shared secret, and a browser could only send
# it by baking it into the bundle. Use VITE_LLM_PROVIDER=lmstudio instead.
VITE_OPENAI_COMPATIBLE_BASE_URL=
VITE_OPENAI_COMPATIBLE_MODEL=

# ─── LiveKit server keys (livekitToken function) ───────────────────────────
#   supabase secrets set LIVEKIT_URL=wss://... LIVEKIT_API_KEY=API... LIVEKIT_API_SECRET=...
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Email provider (either one; sendApprovedDraft / followups) ────────────
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=noreply@talentstack.org

# ─── Cron gating (scheduledFollowupRun; required in production) ────────────
CRON_SECRET=

# ─── Stripe (commercialization phase) ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
