# Mobile client env. Copy to .env.local for local dev.
#
# ⚠ EXPO_PUBLIC_* vars are BAKED IN AT BUILD TIME, not read at runtime. A build
# carries whatever these were when `eas build` ran, so set them per EAS profile
# (Expo dashboard → Project → Environment variables) or the APK will point at
# the wrong project. Changing them requires a NEW BUILD — an `eas update` will
# not pick them up.
#
# Same values as the web app's VITE_SUPABASE_* — same project, same anon key.
# The anon key is public by design; RLS + migration 020's approval gate are what
# actually protect the data.

EXPO_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
