{
  "expo": {
    "name": "TalentStack",
    "slug": "recruiter-x",
    "version": "1.0.0",
    "scheme": "talentstack",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.talentstack.recruiterx",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "TalentStack uses Face ID to unlock candidate data on this device."
      }
    },
    "android": {
      "package": "org.talentstack.recruiterx",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TalentStack uses Face ID to unlock candidate data on this device."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e79dbafd-5552-425c-ab7e-44022511170c"
      }
    },
    "owner": "saradhi0003s-team",
    "updates": {
      "url": "https://u.expo.dev/e79dbafd-5552-425c-ab7e-44022511170c"
    }
  }
}
